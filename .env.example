# ===== 应用配置 =====
APP_NAME=电子集章本
# 生产环境设为 false
DEBUG=false

# ===== 数据库 =====
# 留空则使用 config.py 中锚定到项目根的绝对路径默认值
# DATABASE_URL=sqlite:///./data/cyber_stamping.db

# ===== 存储路径（相对项目根）=====
DATA_DIR=data
STAMPS_DIR=data/stamps
ORIGINAL_DIR=data/stamps/original
STICKER_DIR=data/stamps/sticker

# ===== 认证 =====
# 请在生产环境修改 SECRET_KEY（可用 python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=change_me_in_production_please_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 单密码登录账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ===== 高德 Web 服务 API（地理编码 / 逆地理编码）=====
# 申请：https://lbs.amap.com/api/webservice/guide/create-project/get-key
# 个人开发者每日 5000 次免费额度；留空则地理编码自动降级（不阻断上传）
AMAP_KEY=

# ===== rembg 抠图模型 =====
# 可选：u2netp(~4.7MB,默认快速) / u2net(~176MB,高质量) / silueta(~43MB)
# 模型首次启动需下载到 ~/.u2net/<name>.onnx，国内网络可能超时
# 可手动下载后放置到该目录，或在有外网环境预先下载
REMBG_MODEL=u2netp

# ===== 印章抠图方法 =====
# extractor：高保真 Alpha 提取（新，纯 OpenCV，不依赖 AI 模型）
# legacy：旧版 R-G 通道分层 + rembg
SEGMENT_METHOD=extractor
# extractor 预设：default（兼顾） / preserve_light（保淡墨） / conservative（干净）
EXTRACTOR_PRESET=default
